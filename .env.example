# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE CONFIGURATION (Optional - Supabase or Neon PostgreSQL)
# When provided, connects to Supabase/Postgres. Otherwise falls back to persistent local storage.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# GOOGLE CLOUD CONSOLE AUTHENTICATION (Optional)
# If provided, enables live Google Cloud OAuth 2.0. Otherwise enables interactive one-click Google account chooser!
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# MAILGUN TRANSACTIONAL EMAIL CONFIGURATION (Optional)
# If provided, dispatches live emails through Mailgun API. Otherwise logs and previews confirmation receipts directly in-app.
MAILGUN_API_KEY="key-your-mailgun-api-key"
MAILGUN_DOMAIN="mg.ayestudio.lagos"
MAILGUN_FROM_EMAIL="AYÉ STUDIO Lagos <atelier@ayestudio.lagos>"
MAILGUN_API_BASE_URL="https://api.mailgun.net"
